{
  "name": "@meginhufr/brua-cli",
  "version": "0.1.0",
  "description": "Brua from the command line and CI: push images and animations into change sets, and read what the current release serves.",
  "author": "Meginhufr AS <hello@brua.dev> (https://brua.dev)",
  "license": "MIT",
  "homepage": "https://brua.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meginhufr/brua-cli.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "brua": "./dist/brua.js"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/brua.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/brua.js",
    "check": "tsc -p .",
    "test": "tsc -p . && node --test \"test/**/*.test.ts\"",
    "generate": "curl -sf ${BRUA_API_URL:-http://localhost:7800}/swagger/v1/swagger.json -o openapi.json && openapi-typescript openapi.json -o src/openapi.d.ts",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3"
  }
}
